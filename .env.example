# Copy this file to .env and fill in the real values.
# On Vercel, add the same three variables under Project -> Settings -> Environment Variables.

# Resend API key - sends the internal feedback email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sending address (must be on a domain verified in Resend)
RESEND_FROM=reports@mail.splendidmoving.com

# Who receives the feedback. Comma-separated for multiple recipients.
# Defaults to info@splendidmoving.com if left unset.
FEEDBACK_TO=info@splendidmoving.com
